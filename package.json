{
  "name": "can_i_help",
  "version": "1.0.0",
  "description": "run frontend and backend",
  "homepage": "https://github.com/HiagoCS/can_i_help#readme",
  "bugs": {
    "url": "https://github.com/HiagoCS/can_i_help/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiagoCS/can_i_help.git"
  },
  "license": "ISC",
  "author": "HiagoCS",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "db:init": "npm --prefix backend run db:reset && npm --prefix backend run db:generate && npm --prefix backend run db:migrate && npm --prefix backend run db:seed",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "setup": "node setup.js",
    "setup:images": "node images.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "dep": "^1.5.8"
  }
}
